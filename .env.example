# Spring Boot / PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/shopmall
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_DDL=update

# Redis session store
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ message broker
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VIRTUAL_HOST=/

# MQ topology names are defined in code; this only configures publisher confirm timeout.
MQ_PUBLISH_CONFIRM_TIMEOUT=5s

# File storage and signed download URLs
FILE_STORAGE_PATH=./storage
FILE_BASE_URL=http://localhost:8080
FILE_SIGNING_SECRET=replace-with-a-long-random-secret
FILE_DOWNLOAD_TTL_SECONDS=300
FILE_MAX_SIZE=100MB
FILE_MAX_REQUEST_SIZE=2GB
FILE_MAX_BATCH_SIZE=20
FILE_MAX_SIZE_BYTES=104857600
FILE_PUBLIC_TTL_SECONDS=60
FILE_USER_TTL_SECONDS=300
FILE_ADMIN_TTL_SECONDS=180
FILE_ORDER_TTL_SECONDS=300

# JWT signing; use a random value of at least 32 bytes
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
JWT_TTL_SECONDS=3600

# Fixed test administrator (disabled by default)
AUTH_TEST_ADMIN_ENABLED=false
AUTH_TEST_ADMIN_TOKEN=replace-with-a-test-only-fixed-token
AUTH_TEST_ADMIN_USERNAME=test-admin
AUTH_TEST_ADMIN_EMAIL=test-admin@localhost
AUTH_TEST_ADMIN_PASSWORD=admin

# AI 模型客户端：支持 DIRECT、HTTP、SOCKS5 代理。生产环境默认禁止私网模型地址。
AI_MODEL_CATALOG_TTL=10m
AI_PROXY_MODE=DIRECT
AI_PROXY_HOST=
AI_PROXY_PORT=0
AI_PROXY_USERNAME=
AI_PROXY_PASSWORD=
AI_DNS_MODE=LOCAL
AI_ALLOW_PRIVATE_NETWORK=false
AI_CONNECT_TIMEOUT=10s
AI_RESPONSE_TIMEOUT=90s
