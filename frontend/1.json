  "dialogues": [
    {
      "scene_id": "scene_001",
      "speaker_id": "character_001",
      "text": "退后！再敢近我夫人半步，便将尔等尽数斩尽！",
      "target": "character_007",
      "emotion": "杀伐凌厉、护妻",
      "purpose": "制造冲突"
    },
    {
      "scene_id": "scene_001",
      "speaker_id": "character_002",
      "text": "沈长临！那不是敌军，是虫子！你拿冷兵器砍星际生物，疯了吗！",
      "target": "character_001",
      "emotion": "惊慌、焦急、吐槽",
      "purpose": "交代信息"
    },
    {
      "scene_id": "scene_002",
      "speaker_id": "character_001",
      "text": "此地无城无驿，百姓却皆持火器，莫非已入妖界？",
      "target": "character_002",
      "emotion": "困惑、警惕",
      "purpose": "交代人物认知冲突"
    },
    {
      "scene_id": "scene_002",
      "speaker_id": "character_002",
      "text": "这里叫星际战场！那艘飞船不是电视，你别再问“戏台为何飞上天”了！",
      "target": "character_001",
      "emotion": "无奈、急躁",
      "purpose": "交代信息"
    },
    {
      "scene_id": "scene_002",
      "speaker_id": "character_001",
      "text": "方才那面发光铜镜，竟能显出千里之外的军阵？",
      "target": "character_002",
      "emotion": "惊异、疑惑",
      "purpose": "交代信息"
    },
    {
      "scene_id": "scene_002",
      "speaker_id": "character_002",
      "text": "那叫战术地图，不是铜镜！还有，这个世界没有网络，所有通讯都靠战场终端，懂了吗！",
      "target": "character_001",
      "emotion": "不耐烦、解释",
      "purpose": "交代信息"
    },
    {
      "scene_id": "scene_002",
      "speaker_id": "character_003",
      "text": "祝无虞，听到回话！你们的位置正在被时空抹除，监控里只剩一片血雾！",
      "target": "character_002",
      "emotion": "急促、担忧",
      "purpose": "推动剧情"
    },
    {
      "scene_id": "scene_002",
      "speaker_id": "character_004",
      "text": "沈长临，报身份！姓名、来历、有没有武器？",
      "target": "character_001",
      "emotion": "警戒、审问",
      "purpose": "制造冲突"
    },
    {
      "scene_id": "scene_002",
      "speaker_id": "character_001",
      "text": "沈长临，大晟边军主将，手中之物乃佩刀。",
      "target": "character_004",
      "emotion": "镇定、严肃",
      "purpose": "交代身份"
    },
    {
      "scene_id": "scene_002",
      "speaker_id": "character_004",
      "text": "大晟是哪颗星球？",
      "target": "character_001",
      "emotion": "困惑、怀疑",
      "purpose": "制造冲突"
    },
    {
      "scene_id": "scene_002",
      "speaker_id": "character_002",
      "text": "他身份洗白中，证件马上补，先别把我们当虫族间谍！",
      "target": "character_004",
      "emotion": "机警、辩解",
      "purpose": "制造冲突"
    },
    {
      "scene_id": "scene_003",
      "speaker_id": "character_002",
      "text": "等等，这根金钗能换星币！",
      "target": "character_001",
      "emotion": "惊喜、现实焦虑",
      "purpose": "推动剧情"
    },
    {
      "scene_id": "scene_003",
      "speaker_id": "character_001",
      "text": "那是夫人发钗，岂可变卖？",
      "target": "character_002",
      "emotion": "不舍、严肃",
      "purpose": "制造冲突"
    },
    {
      "scene_id": "scene_003",
      "speaker_id": "character_002",
      "text": "不卖我们连母婴营养剂都买不起！沈夫人已经把整间母婴店包圆了，还在通讯里催你回去！",
      "target": "character_001",
      "emotion": "焦急、务实",
      "purpose": "交代信息"
    },
    {
      "scene_id": "scene_003",
      "speaker_id": "character_005",
      "text": "无虞放心，奶粉、护甲、婴儿舱，全由我沈家包了！谁敢欺你，我便派舰队过去！",
      "target": "character_002",
      "emotion": "豪气、护短",
      "purpose": "表达情感"
    },
    {
      "scene_id": "scene_003",
      "speaker_id": "character_001",
      "text": "母亲竟已拥百万雄兵？",
      "target": "character_005",
      "emotion": "震惊、误解",
      "purpose": "制造误会"
    },
    {
      "scene_id": "scene_003",
      "speaker_id": "character_002",
      "text": "那是购物车，不是舰队！",
      "target": "character_001",
      "emotion": "无奈、吐槽",
      "purpose": "制造冲突"
    },
    {
      "scene_id": "scene_004",
      "speaker_id": "character_001",
      "text": "筋脉既乱，便伏地受死！",
      "target": "character_007",
      "emotion": "冷酷、威压",
      "purpose": "推动动作"
    },
    {
      "scene_id": "scene_004",
      "speaker_id": "character_003",
      "text": "他徒手拆了刺蛇？这不是人类！",
      "target": "character_002",
      "emotion": "失声、震惊",
      "purpose": "制造悬念"
    },
    {
      "scene_id": "scene_004",
      "speaker_id": "character_002",
      "text": "不好！肚子疼！",
      "target": "character_001",
      "emotion": "疼痛、惊慌",
      "purpose": "推动剧情"
    },
    {
      "scene_id": "scene_004",
      "speaker_id": "character_001",
      "text": "无虞，你要生产？",
      "target": "character_002",
      "emotion": "焦急、担心",
      "purpose": "表达情感"
    },
    {
      "scene_id": "scene_004",
      "speaker_id": "character_002",
      "text": "不是！是高速跃迁把我颠着了！但再拖下去，早产真要来了！",
      "target": "character_001",
      "emotion": "紧张、解释",
      "purpose": "推动剧情"
    },
    {
      "scene_id": "scene_004",
      "speaker_id": "character_003",
      "text": "那是什么？这里明明是克普鲁星区，为什么会出现宋代古墓？",
      "target": "character_002",
      "emotion": "困惑、惊惧",
      "purpose": "制造悬念"
    },
    {
      "scene_id": "scene_004",
      "speaker_id": "character_001",
      "text": "此墓碑上，刻的是本将军的生辰。",
      "target": "character_002",
      "emotion": "凝重、难以置信",
      "purpose": "交代信息"
    },
    {
      "scene_id": "scene_004",
      "speaker_id": "character_002",
      "text": "可碑文最后一行写着——“沈长临死于今日”。",
      "target": "character_001",
      "emotion": "声音发紧、恐惧",
      "purpose": "制造悬念"
    },
    {
      "scene_id": "scene_005",
      "speaker_id": "character_001",
      "text": "碑上写我今日身死，可我偏要让这天命先死！",
      "target": "character_002",
      "emotion": "决绝、不屈",
      "purpose": "表达主题"
    },
    {
      "scene_id": "scene_005",
      "speaker_id": "character_008",
      "text": "将军，你终于回来了。",
      "target": "character_001",
      "emotion": "神秘、低沉",
      "purpose": "制造悬念"
    },
    {
      "scene_id": "scene_005",
      "speaker_id": "character_002",
      "text": "沈长临……里面那个穿星际战甲的人，为什么长着你的脸？",
      "target": "character_001",
      "emotion": "惊恐、难以置信",
      "purpose": "揭示异常"
    },
    {
      "scene_id": "scene_005",
      "speaker_id": "character_006",
      "text": "把孩子留下。",
      "target": "character_002",
      "emotion": "冷酷、威胁",
      "purpose": "制造悬念"
    }
